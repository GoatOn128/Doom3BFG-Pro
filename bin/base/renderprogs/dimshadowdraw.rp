renderprog dimshadowdraw {
	hlsl_vp {

		struct VS_IN {
			float4 position : POSITION;
		};

		struct VS_OUT {
			float4 position : POSITION;
		};

		void main( VS_IN vertex, out VS_OUT result ) {
			result.position.x = dot4( vertex.position, rpMVPmatrixX );
			result.position.y = dot4( vertex.position, rpMVPmatrixY );
			result.position.z = dot4( vertex.position, rpMVPmatrixZ );
			result.position.w = dot4( vertex.position, rpMVPmatrixW );
		}
	}
	hlsl_fp {

		uniform sampler2D samp0 : register(s0); // view depth copy
		uniform sampler2DShadow samp1 : register(s1); // dim shadow depth target

		struct PS_IN {
			half4 position : VPOS;
		};

		struct PS_OUT {
			half4 color : COLOR;
		};

		void main( PS_IN fragment, out PS_OUT result ) {
			// window pixel to normalized view uv, the origin is in zw
			float2 viewUV = ( fragment.position.xy - rpWindowCoord.zw ) * rpWindowCoord.xy;

			// rebuild the clip space position of the pixel from the depth
			// copy and unproject it back to world space
			float4 clipPos;
			clipPos.x = viewUV.x * 2.0 - 1.0;
			clipPos.y = viewUV.y * 2.0 - 1.0;
			clipPos.z = tex2D( samp0, viewUV ).x * 2.0 - 1.0;
			clipPos.w = 1.0;

			float4 worldPos;
			worldPos.x = dot4( clipPos, rpShadowMatrixX );
			worldPos.y = dot4( clipPos, rpShadowMatrixY );
			worldPos.z = dot4( clipPos, rpShadowMatrixZ );
			worldPos.w = dot4( clipPos, rpShadowMatrixW );
			worldPos.xyz /= worldPos.w;

			// project the world position into the dim shadow target
			float4 shadowCoord;
			shadowCoord.x = dot4( worldPos, rpShadowProjectionX );
			shadowCoord.y = dot4( worldPos, rpShadowProjectionY );
			shadowCoord.z = dot4( worldPos, rpShadowProjectionZ );
			shadowCoord.w = dot4( worldPos, rpShadowProjectionW );
			shadowCoord.xyz /= shadowCoord.w;

			// only pixels inside the caster projection can be shadowed
			float inside = step( 0.0, shadowCoord.x ) * step( shadowCoord.x, 1.0 ) *
				step( 0.0, shadowCoord.y ) * step( shadowCoord.y, 1.0 ) *
				step( 0.0, shadowCoord.z ) * step( shadowCoord.z, 1.0 );

			// depth bias keeps the caster itself lit
			shadowCoord.z -= rpShadowParams.z;
			half shadow = tex2D( samp1, shadowCoord.xyz ).x;
			shadow = lerp( 1.0, shadow, inside );

			half fade = rpShadowParams.x;
			result.color = half4( 0.0, 0.0, 0.0, ( 1.0 - shadow ) * fade );
		}
	}
}
