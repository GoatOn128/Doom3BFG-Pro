#include "global.inc"

uniform sampler2D	samp0 : register(s0); // texture 1 is the per-surface bump map
uniform sampler2D	samp1 : register(s1); // texture 2 is the light falloff texture
uniform sampler2D	samp2 : register(s2); // texture 3 is the light projection texture
uniform sampler2D	samp3 : register(s3); // texture 4 is the per-surface diffuse map
uniform sampler2D	samp4 : register(s4); // texture 5 is the per-surface specular map
uniform sampler2DShadow samp5 : register(s5); // light depth atlas

struct PS_IN {
	half4 position	: VPOS;
	half4 texcoord0	: TEXCOORD0_centroid;
	half4 texcoord1	: TEXCOORD1_centroid;
	half4 texcoord2	: TEXCOORD2_centroid;
	half4 texcoord3	: TEXCOORD3_centroid;
	half4 texcoord4	: TEXCOORD4_centroid;
	half4 texcoord5	: TEXCOORD5_centroid;
	half4 texcoord6	: TEXCOORD6_centroid;
	half4 texcoord7	: TEXCOORD7_centroid;
	half4 color		: COLOR0;
};

struct PS_OUT {
	half4 color : COLOR;
};

void main( PS_IN fragment, out PS_OUT result ) {
	half shadow = 1.0;
	if ( rpShadowParams.x > 0.5 ) {
		float3 shadowCoord;
		if ( rpShadowParams.x < 1.5 ) {
			shadowCoord = fragment.texcoord7.xyz / fragment.texcoord7.w;
		} else {
			float3 absCoord = abs( fragment.texcoord7.xyz );
			float maxCoord = max( absCoord.x, max( absCoord.y, absCoord.z ) );
			float4 axis;
			axis.xyz = step( float3( maxCoord, maxCoord, maxCoord ), absCoord );
			axis.yz = saturate( axis.yz - axis.xx - axis.xy );
			axis.w = 0.0;
			float4 rotate = axis.yxxy + axis.zwzw;
			float4 flatCoord;
			flatCoord.x = dot2( rotate.xy, fragment.texcoord7.xz );
			flatCoord.y = dot2( rotate.zw, fragment.texcoord7.yz );
			flatCoord.z = -maxCoord;
			flatCoord.w = fragment.texcoord7.w;
			float3 negativeSide = 1.0 - step( float3( 0.0, 0.0, 0.0 ), fragment.texcoord7.xyz );
			float sBias = 0.5 + dot3( axis.xyz, negativeSide );
			float tBias = 0.5 + dot3( axis.xyz, float3( 0.0, 1.0, 2.0 ) );
			float4 faceCoord;
			faceCoord.x = dot4( flatCoord, rpShadowProjectionX + sBias * rpShadowProjectionW );
			faceCoord.y = dot4( flatCoord, rpShadowProjectionY + tBias * rpShadowProjectionW );
			faceCoord.z = dot4( flatCoord, rpShadowProjectionZ );
			faceCoord.w = dot4( flatCoord, rpShadowProjectionW );
			shadowCoord = faceCoord.xyz / faceCoord.w;
			shadowCoord.xy *= ( 1.0 / 3.0 );
		}
		shadowCoord.z -= rpShadowParams.z;
		float insideShadowMap = step( 0.0, shadowCoord.x ) * step( shadowCoord.x, 1.0 ) *
			step( 0.0, shadowCoord.y ) * step( shadowCoord.y, 1.0 ) *
			step( 0.0, shadowCoord.z ) * step( shadowCoord.z, 1.0 );
		float2 texel = float2( rpShadowParams.y, rpShadowParams.y );
		half filteredShadow = 0.25 * ( tex2D( samp5, shadowCoord + float3( -texel.x, -texel.y, 0.0 ) ).x +
			tex2D( samp5, shadowCoord + float3( texel.x, -texel.y, 0.0 ) ).x +
			tex2D( samp5, shadowCoord + float3( -texel.x, texel.y, 0.0 ) ).x +
			tex2D( samp5, shadowCoord + float3( texel.x, texel.y, 0.0 ) ).x );
		shadow = lerp( 1.0, filteredShadow, insideShadowMap );
	}
	half4 bumpMap =			tex2D( samp0, fragment.texcoord1.xy );
	half4 lightFalloff =	idtex2Dproj( samp1, fragment.texcoord2 );
	half4 lightProj	=		idtex2Dproj( samp2, fragment.texcoord3 );
	half4 YCoCG =			tex2D( samp3, fragment.texcoord4.xy );
	half4 specMap =			tex2D( samp4, fragment.texcoord5.xy );

	half3 lightVector = normalize( fragment.texcoord0.xyz );
	half3 diffuseMap = ConvertYCoCgToRGB( YCoCG );

	half3 localNormal;
	localNormal.xy = bumpMap.wy - 0.5;
	localNormal.z = sqrt( abs( dot( localNormal.xy, localNormal.xy ) - 0.25 ) );
	localNormal = normalize( localNormal );

	const half specularPower = 10.0f;
	half hDotN = dot3( normalize( fragment.texcoord6.xyz ), localNormal );
	half3 specularContribution = _half3( pow( hDotN, specularPower ) );

	half3 diffuseColor = diffuseMap * rpDiffuseModifier.xyz;
	half3 specularColor = specMap.xyz * specularContribution * rpSpecularModifier.xyz;
	half3 lightColor = dot3( lightVector, localNormal ) * lightProj.xyz * lightFalloff.xyz;

	result.color.xyz = ( diffuseColor + specularColor ) * lightColor * fragment.color.xyz * shadow;
	result.color.w = 1.0;
}
