{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (Visual Studio Win32)",
            "type": "shell",
            "command": "cmake -S neo -B out -A Win32",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build (Win32 debug)",
            "type": "shell",
            "command": "cmake --build out --config Debug --parallel",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "Configure (Visual Studio Win32)",
            "problemMatcher": []
        },
        {
            "label": "Build (Win32 release)",
            "type": "shell",
            "command": "cmake --build out --config Release --parallel",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "dependsOn": "Configure (Visual Studio Win32)",
            "problemMatcher": []
        },
        {
            "label": "Clean (Win32)",
            "type": "shell",
            "command": "cmake --build out --config Debug --target clean",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
